{
  "name": "@openaac-avatar/artkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Compiles the designer's Inkscape SVGs into the art kit JSON the render core uses, and checks them against the art rules.",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "compile": "tsx --conditions=source src/main.ts compile",
    "validate": "tsx --conditions=source src/main.ts validate",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@openaac-avatar/core": "workspace:*",
    "@xmldom/xmldom": "^0.8.11",
    "clipper-lib": "6.4.2",
    "svgpath": "^2.6.0"
  },
  "devDependencies": {
    "@types/clipper-lib": "6.4.0"
  }
}
